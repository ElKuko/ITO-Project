# Ito Merchandising App - Environment Variables
# Copy this file to .env and fill in your values

# Database URL
# For local development (SQLite): leave empty to use default
# For production (PostgreSQL): postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Secret key for JWT tokens (CHANGE THIS IN PRODUCTION!)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# Token expiry in seconds (default: 86400 = 24 hours)
TOKEN_EXPIRY_SECONDS=86400

# Upload directory (default: backend/uploads) - used for local storage only
UPLOAD_DIR=

# ─── Cloudflare R2 Storage (Production) ───────────────────────────────────
# If these are set, images are stored in R2 instead of local filesystem.
# Leave empty for local development.

# Your Cloudflare account ID (from dashboard URL)
R2_ACCOUNT_ID=

# R2 API credentials (create at: R2 > Manage R2 API Tokens)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# R2 bucket name
R2_BUCKET_NAME=ito-uploads

# Public URL for the R2 bucket (from bucket Settings > Public access)
R2_PUBLIC_URL=
